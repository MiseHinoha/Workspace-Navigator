# JWT Secret -- REQUIRED. Generate one that is unique to this deployment:
#   openssl rand -base64 48
# The server refuses to start in production without it (a guessable secret lets
# anyone forge a login token).
JWT_SECRET=

# Optional: password for the very first administrator account (username: admin).
# Only used when the database is empty. Leave it blank and the server generates
# a random password and prints it once in the logs.
# ADMIN_INITIAL_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=production

# Data Directory
DATA_DIR=/app/data

# Optional: how many days of device-sync sessions to keep (default 30)
# SESSION_RETENTION_DAYS=30

# Optional: login failure limits, per 15-minute window
# AUTH_RATE_IP_LIMIT=30
# AUTH_RATE_USER_LIMIT=200
# AUTH_RATE_IP_USER_LIMIT=10
